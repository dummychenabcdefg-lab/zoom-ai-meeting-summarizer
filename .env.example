# Copy this file to `.env` (optional) and fill in your key.
# The script reads the key from the ZOOM_API_KEY environment variable,
# so you can also just run: export ZOOM_API_KEY="your_api_key_here"

# Get a free API key in the AI Services Developer Portal:
# https://www.zoom.ai/
# (sign up for a free trial; a no-key interactive playground is also available there)
ZOOM_API_KEY=your_api_key_here
